{
  "name": "curly-adventure",
  "version": "0.1.0",
  "description": "Scaffolding for a text-based adventure game in TypeScript",
  "private": true,
  "engines": {
    "node": "^22.12.0",
    "npm": "^11.21.1"
  },
  "packageManager": "npm@11.21.1",
  "scripts": {
    "audit": "node scripts/audit.cjs",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "dev:refresh": "browser-sync start --proxy http://localhost:8080 --files 'public/**/*' --no-open --port 3000 --ui-port 3001",
    "dev:docker": "concurrently -k -n webpack,browsersync \"npm:dev\" \"npm:dev:refresh\"",
    "lint": "npm run typecheck:app && npm run typecheck:tests",
    "typecheck:app": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json",
    "test": "jest"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.6",
    "jest": "^30.5.2",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  }
}
